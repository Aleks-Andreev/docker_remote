{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 'dore'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=dore",
                    "--package=dore"
                ]
            },
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "full"
            },
            "args": []
        },
        {
            "name": "MSVC Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/target/debug/dore.exe",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "args": ["-v", "down"],
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "full"
                }
            ],
            "cwd": "${workspaceFolder}\\demos\\alpine",
            "preLaunchTask": "rust: cargo build"
        }
    ]
}